{
  "name": "game-news-unified",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "GameNewsUnified 统一游戏资讯数据中心 (GameNews + WX News Wiki + WorkBuddy Steam 三源)",
  "scripts": {
    "schema:apply": "node db/apply-schema.mjs",
    "migrate:dry": "node scripts/migrate-legacy.mjs --dry-run",
    "migrate:run": "node scripts/migrate-legacy.mjs",
    "serve": "node server/api-server.mjs",
    "dev:web": "vite --host 127.0.0.1",
    "build": "vite build",
    "test": "node --test"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^6.0.2",
    "cheerio": "^1.2.0",
    "lucide-react": "^0.468.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router-dom": "^7.17.0",
    "vite": "^8.0.16"
  },
  "engines": {
    "node": ">=22.5"
  }
}

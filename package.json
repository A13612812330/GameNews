{
  "name": "game-news-hub",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm run dev:client\" \"npm run dev:server\"",
    "start": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/start-gamenews.ps1",
    "dev:client": "vite",
    "dev:server": "node server/index.js",
    "build": "vite build",
    "preview": "vite preview --port 64423",
    "check:crawler": "node scripts/crawler-regression.mjs"
  },
  "dependencies": {
    "cheerio": "^1.1.2",
    "concurrently": "^10.0.3",
    "express": "^5.2.1",
    "firecrawl": "^4.31.1",
    "iconv-lite": "^0.7.2",
    "lucide-react": "^0.468.0",
    "node-cron": "^3.0.3",
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.0.2",
    "vite": "^8.0.16"
  }
}
